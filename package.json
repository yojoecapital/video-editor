{
  "name": "video-editor",
  "version": "0.0.1-alpha",
  "description": "Linux-first Electron non-linear video editor",
  "main": "out/main/index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "package": "electron-vite build && electron-builder --linux dir",
    "smoke": "electron-vite build && VE_SMOKE_DIR=/tmp/ve-test VE_SMOKE_OUT=/tmp/ve-test/smoke-out.mp4 electron ."
  },
